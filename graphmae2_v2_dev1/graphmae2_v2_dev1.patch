+        "--difficulty_clip_quantile", "0.95", "--density_bins", "4",
+        "--density_chunk_size", "256",
+    ]
+    old = sys.argv
+    try:
+        sys.argv = arguments
+        args = entry.load_best_configs(entry.build_args())
+        if cli.phase == "smoke":
