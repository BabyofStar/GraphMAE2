+    @staticmethod
+    def varied_graph(device):
+        # Incoming non-self degrees are exactly 0, 1, ..., 15.
+        src = [j for i in range(1, 16) for j in range(i)]
+        dst = [i for i in range(1, 16) for j in range(i)]
