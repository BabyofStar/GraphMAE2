+            activation: str,
+            feat_drop: float,
+            attn_drop: float,
+            negative_slope: float,
+            residual: bool,
+            norm: Optional[str],
+            mask_rate: float = 0.3,
+            remask_rate: float = 0.5,
+            remask_method: str = "random",
+            mask_method: str = "random",
+            encoder_type: str = "gat",
+            decoder_type: str = "gat",
+            loss_fn: str = "byol",
+            drop_edge_rate: float = 0.0,
+            alpha_l: float = 2,
+            lam: float = 1.0,
+            delayed_ema_epoch: int = 0,
+            momentum: float = 0.996,
+            replace_rate: float = 0.0,
+            zero_init: bool = False,
+            input_mask_mode: str = "random",
+            structure_alpha_max: float = 0.5,
+            structure_warmup_ratio: float = 0.2,
+            structure_ramp_end_ratio: float = 0.8,
+            mask_log_interval: int = 100,
+            structure_shuffle_seed: int = 20261025,
+            input_mask_diagnostics: bool = False,
+            difficulty_ema_beta: float = 0.9,
