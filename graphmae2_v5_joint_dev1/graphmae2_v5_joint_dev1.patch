+        self._alpha_l = alpha_l
+        self._delayed_ema_epoch = delayed_ema_epoch
+
+        self.num_remasking = num_remasking
+        self._encoder_type = encoder_type
+        self._decoder_type = decoder_type
+        self._drop_edge_rate = drop_edge_rate
