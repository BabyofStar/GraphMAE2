+def redact(text):
+    text = re.sub(
+        r"(test_loss|test_acc|early-stopping-TestAcc|TestAcc):\s*[^,\s]+",
+        r"\1:[HIDDEN]", text,
+    )
+    return re.sub(
+        r"(# (?:final_acc|early-stopping_acc):)[^\r\n]*",
+        r"\1 [HIDDEN]", text,
+    )
